PORT=4005
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://admin:your_postgres_password@localhost:5432/booking_service_database
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=booking-service

REDIS_URL=redis://:your_redis_password@localhost:6379

INVENTORY_SERVICE_URL=http://localhost:4007
PAYMENT_SERVICE_URL=http://localhost:4006
USER_SERVICE_URL=http://localhost:4001
INTERNAL_SERVICE_KEY=your_shared_internal_service_key_here

# How long a customer has to pay before the held car is released
BOOKING_TTL_SECONDS=600
BOOKING_EXPIRY_CHECK_INTERVAL_MS=30000
LOCK_TTL_SECONDS=600
