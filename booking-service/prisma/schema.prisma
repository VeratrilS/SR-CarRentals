generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CAR_HELD
  PAYMENT_PENDING
  CONFIRMING
  CONFIRMED
  CANCELLING
  FAILED
  CANCELLED
  EXPIRED
}

enum SagaStep {
  HOLD_CAR
  HOLD_SEATS
  CREATE_PAYMENT
  CONFIRM_CAR
  CONFIRM_SEATS
  COMPLETE
}

enum BookingType {
  RENTAL // whole car, self-drive, for a time window
  SEAT // seats on a shared-ride trip, for a stretch of its route
}

enum SagaStepStatus {
  PENDING
  COMPLETED
  COMPENSATING
  COMPENSATED
  FAILED
}

model Booking {
  id                 String        @id @default(uuid())
  type               BookingType   @default(RENTAL)
  userId             String
  carId              String
  registrationNumber String
  carName            String // "Hyundai Creta"
  category           String
  branchId           String
  branchName         String
  city               String
  pickupAt           DateTime
  dropoffAt          DateTime
  status             BookingStatus @default(PENDING)

  // Pricing snapshot (rates can change after booking)
  rentalDays     Int? // RENTAL only
  dailyRate      Float? // RENTAL only
  baseAmount     Float
  discountAmount Float @default(0)
  totalAmount    Float
  refundAmount   Float @default(0)

  // Primary driver (RENTAL only)
  driverName          String?
  driverAge           Int?
  driverLicenseNumber String?
  driverPhone         String?

  // Shared ride (SEAT only): seats on trip `tripId` for stops [fromSeq, toSeq)
  tripId       String?
  routeName    String?
  fromSeq      Int?
  toSeq        Int?
  fromStopName String?
  toStopName   String?
  seatNumbers  Int[]   @default([])
  seatFare     Float? // per seat
  passengers   Json? // [{ name, age, gender, seatNumber }]

  idempotencyKey String    @unique
  paymentOrderId String?   @unique
  lockExpiresAt  DateTime?
  failureReason  String?
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sagaLog SagaLog[]

  @@index([userId])
  @@index([carId])
  @@index([tripId])
  @@index([status])
  @@index([lockExpiresAt, status])
  @@map("bookings")
}

model SagaLog {
  id        String         @id @default(uuid())
  bookingId String
  step      SagaStep
  status    SagaStepStatus @default(PENDING)
  request   Json?
  response  Json?
  error     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("saga_logs")
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  response    Json?
  processedAt DateTime @default(now())

  @@index([eventKey])
  @@map("idempotency_records")
}
