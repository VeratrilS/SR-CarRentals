// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A rental location where cars are picked up and dropped off
model Branch {
  id        String   @id @default(uuid())
  name      String   @unique // "Hitech City"
  code      String   @unique // "HYD-HTC"
  city      String // "Hyderabad"
  state     String?
  address   String?
  openTime  String   @default("08:00")
  closeTime String   @default("22:00")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars       Car[]
  routeStops RouteStop[]

  @@index([name])
  @@index([code])
  @@index([city])
  @@map("branches")
}

enum CarCategory {
  HATCHBACK
  SEDAN
  SUV
  MUV
  LUXURY
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum CarStatus {
  ACTIVE // available for rent
  MAINTENANCE // temporarily off the fleet — future bookings are cancelled
  RETIRED // permanently removed
}

// A physical vehicle in the fleet
model Car {
  id                 String       @id @default(uuid())
  registrationNumber String       @unique // "TS09AB1234"
  make               String // "Hyundai"
  model              String // "Creta"
  year               Int
  category           CarCategory
  transmission       Transmission
  fuelType           FuelType
  seats              Int
  dailyRate          Float // price per 24h in INR
  imageUrl           String?
  status             CarStatus    @default(ACTIVE)
  branchId           String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])
  trips  Trip[]

  @@index([branchId, status])
  @@index([category])
  @@map("cars")
}

// ─── Shared rides ─────────────────────────────────────────────────────────────

// An ordered list of branches a shared ride passes through,
// e.g. Hyderabad (0 km) → Suryapet (135 km) → Vijayawada (275 km)
model Route {
  id        String   @id @default(uuid())
  name      String   @unique // "Hyderabad → Vijayawada"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stops RouteStop[]
  trips Trip[]

  @@map("routes")
}

model RouteStop {
  id            String @id @default(uuid())
  routeId       String
  branchId      String
  sequence      Int // 1, 2, 3… order along the route
  offsetMinutes Int // minutes after departure that the car reaches this stop
  distanceKm    Float // distance from the first stop

  route  Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([routeId, sequence])
  @@unique([routeId, branchId])
  @@map("route_stops")
}

enum TripStatus {
  SCHEDULED
  CANCELLED
}

// One run of a car along a route at a fixed time; passengers book seats on it
model Trip {
  id          String     @id @default(uuid())
  routeId     String
  carId       String
  departureAt DateTime
  arrivalAt   DateTime
  driverName  String
  farePerKm   Float // seat price = distance travelled × farePerKm (min fare applies)
  status      TripStatus @default(SCHEDULED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  route Route @relation(fields: [routeId], references: [id])
  car   Car   @relation(fields: [carId], references: [id])

  @@index([departureAt, status])
  @@index([carId, status])
  @@map("trips")
}
