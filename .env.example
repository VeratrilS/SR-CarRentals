# Copy to .env and set strong values. docker-compose.yml reads these.
# The same Postgres/Redis passwords go into each service's DATABASE_URL / REDIS_URL.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_postgres
REDIS_PASSWORD=change_me_redis
PGADMIN_EMAIL=admin@sr-carrentals.local
PGADMIN_PASSWORD=change_me_pgadmin
