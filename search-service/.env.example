PORT=4002
NODE_ENV=development
LOG_LEVEL=info

ELASTICSEARCH_URL=http://localhost:9200

KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=search-service

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# true = drop & rebuild indices on startup by replaying Kafka history
ES_RECREATE_INDICES=true

# Live seat counts for shared-ride search results
INVENTORY_SERVICE_URL=http://localhost:4007
INTERNAL_SERVICE_KEY=your_shared_internal_service_key_here
