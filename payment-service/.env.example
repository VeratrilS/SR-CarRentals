PORT=4006
NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://admin:your_postgres_password@localhost:5432/payment_service_database
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=payment-service

INTERNAL_SERVICE_KEY=your_shared_internal_service_key_here

# https://dashboard.razorpay.com/app/website-app-settings/api-keys (Test Mode)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Any random string; enter the same value when creating a webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
