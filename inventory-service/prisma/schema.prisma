generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum HoldStatus {
  LOCKED // temporarily held while the customer pays (expires)
  BOOKED // confirmed rental
}

// Read model of a fleet car, built from admin CAR_CREATED / CAR_UPDATED events
model CarInventory {
  id                 String   @id @default(uuid())
  carId              String   @unique
  registrationNumber String
  make               String
  model              String
  category           String
  transmission       String
  fuelType           String
  seats              Int
  dailyRate          Float
  branchId           String
  branchCode         String
  branchName         String
  city               String
  status             String   @default("ACTIVE")
  version            Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  holds RentalHold[]

  @@index([branchId, status])
  @@map("car_inventories")
}

// A car reserved for the half-open interval [startAt, endAt).
// Two holds on the same car conflict iff a.startAt < b.endAt AND b.startAt < a.endAt.
// A Postgres EXCLUSION constraint (see src/config/dbConstraints.js) enforces this at
// the database level as a last line of defence against double booking.
model RentalHold {
  id            String     @id @default(uuid())
  carId         String
  bookingId     String     @unique
  startAt       DateTime
  endAt         DateTime
  status        HoldStatus @default(LOCKED)
  lockedBy      String
  lockedAt      DateTime   @default(now())
  lockExpiresAt DateTime?
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  car CarInventory @relation(fields: [carId], references: [carId], onDelete: Cascade)

  @@index([carId, status])
  @@index([carId, startAt, endAt])
  @@index([lockExpiresAt, status])
  @@map("rental_holds")
}

// ─── Shared rides ─────────────────────────────────────────────────────────────

// Read model of a scheduled trip, built from admin TRIP_SCHEDULED events
model TripInventory {
  id             String   @id @default(uuid())
  tripId         String   @unique
  carId          String
  routeName      String
  departureAt    DateTime
  arrivalAt      DateTime
  status         String   @default("SCHEDULED")
  passengerSeats Int
  farePerKm      Float
  driverName     String
  stops          Json // [{ sequence, branchId, name, code, city, distanceKm, time }]
  car            Json // { carId, make, model, registrationNumber, category, seats, imageUrl }
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  seatHolds TripSeatHold[]

  @@index([departureAt, status])
  @@map("trip_inventories")
}

// One seat on one trip, held for the stops [fromSeq, toSeq).
// Same seat, overlapping stretches conflict: a.fromSeq < b.toSeq AND b.fromSeq < a.toSeq.
// Enforced at the database level by an EXCLUSION constraint (see src/config/dbConstraints.js).
model TripSeatHold {
  id            String     @id @default(uuid())
  tripId        String
  seatNumber    Int
  fromSeq       Int
  toSeq         Int
  status        HoldStatus @default(LOCKED)
  bookingId     String
  lockedBy      String
  lockedAt      DateTime   @default(now())
  lockExpiresAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  trip TripInventory @relation(fields: [tripId], references: [tripId], onDelete: Cascade)

  @@index([tripId, seatNumber])
  @@index([bookingId])
  @@index([lockExpiresAt, status])
  @@map("trip_seat_holds")
}

model IdempotencyRecord {
  id          String   @id @default(uuid())
  eventKey    String   @unique
  processedAt DateTime @default(now())

  @@index([eventKey])
  @@map("idempotency_records")
}
